# Copy to .env and export these (or set them in your service manager) before `npm start`
PORT=3000
DB_FILE=./data/inventory.db
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
# 1 = staff must sign in before they can search (default 0: search is open on the shop network)
SEARCH_REQUIRES_LOGIN=0
# Set when running behind HTTPS / a reverse proxy
# TRUST_PROXY=1
# COOKIE_SECURE=1
SESSION_HOURS=12
